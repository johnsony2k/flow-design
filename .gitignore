* {
  box-sizing: border-box;
}

:root {
  font-family: Inter, 'Segoe UI', sans-serif;
  color: #e5eef8;
  background: #0f172a;
  line-height: 1.5;
  font-weight: 400;
  color-scheme: dark;
}

html, body, #root {
  margin: 0;
  min-height: 100%;
  min-width: 100%;
  background: linear-gradient(180deg, #0f172a 0%, #111827 100%);
}

button, input, textarea {
  font: inherit;
}

button {
  cursor: pointer;
}

.app-shell {
  max-width: 1200px;
  margin: 0 auto;
  padding: 24px 16px 48px;
}

.topbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16px;
  margin-bottom: 24px;
}

.topbar h1,
.panel h2 {
  margin: 0;
}

.eyebrow {
  margin: 0 0 6px;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  font-size: 11px;
  font-weight: 700;
  color: #94a3b8;
}

.header-actions {
  display: flex;
  gap: 12px;
  align-items: center;
  flex-wrap: wrap;
}

.dashboard {
  display: flex;
  flex-direction: column;
  gap: 20px;
}

.panel {
  background: rgba(15, 23, 42, 0.8);
  border: 1px solid rgba(148, 163, 184, 0.12);
  border-radius: 18px;
  padding: 20px;
  box-shadow: 0 10px 30px rgba(15, 23, 42, 0.28);
}

.summary-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(140px, 1fr));
  gap: 16px;
}

.metric-card {
  background: rgba(30, 41, 59, 0.8);
  border-radius: 16px;
  padding: 18px 16px;
  display: flex;
  flex-direction: column;
  gap: 8px;
  min-height: 110px;
}

.metric-card.accent {
  background: linear-gradient(135deg, rgba(213, 79, 79, 0.24), rgba(239, 68, 68, 0.18));
  border: 1px solid rgba(248, 113, 113, 0.4);
}

.metric-card span {
  color: #cbd5e1;
  font-size: 13px;
  text-transform: uppercase;
  letter-spacing: 0.08em;
}

.metric-card strong {
  font-size: clamp(1.4rem, 3vw, 2.1rem);
  line-height: 1.2;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20px;
  margin-bottom: 18px;
}

.section-header.compact {
  margin-bottom: 14px;
}

.target-input {
  display: flex;
  flex-direction: column;
  gap: 8px;
  font-size: 13px;
  color: #cbd5e1;
}

.target-input input,
.entry-form input,
.entry-form textarea {
  border: 1px solid rgba(148, 163, 184, 0.2);
  background: rgba(15, 23, 42, 0.7);
  border-radius: 10px;
  color: #f8fafc;
  padding: 10px 12px;
  outline: none;
}

.target-input input:focus,
.entry-form input:focus,
.entry-form textarea:focus {
  border-color: rgba(252, 165, 165, 0.8);
  box-shadow: 0 0 0 3px rgba(248, 113, 113, 0.16);
}

.chart {
  width: 100%;
  height: 240px;
  border-radius: 12px;
  background: linear-gradient(180deg, rgba(15, 23, 42, 0.4), rgba(30, 41, 59, 0.8));
  padding: 12px;
}

.chart-line {
  fill: none;
  stroke: #f87171;
  stroke-width: 4;
  stroke-linecap: round;
  stroke-linejoin: round;
}

.chart-point {
  fill: #fef2f2;
  stroke: #ef4444;
  stroke-width: 2;
}

.content-grid {
  display: grid;
  grid-template-columns: minmax(260px, 420px) minmax(0, 1fr);
  gap: 20px;
}

.entry-form {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.entry-form label {
  display: flex;
  flex-direction: column;
  gap: 8px;
  color: #cbd5e1;
  font-size: 14px;
}

.form-actions {
  display: flex;
  justify-content: flex-end;
}

.primary-button,
.ghost-button,
.link-button {
  border: none;
  border-radius: 10px;
  transition: transform 0.2s ease, opacity 0.2s ease;
}

.primary-button {
  background: linear-gradient(135deg, #ef4444, #f97316);
  color: white;
  padding: 10px 16px;
  font-weight: 700;
}

.ghost-button {
  background: rgba(51, 65, 85, 0.75);
  color: #f8fafc;
  padding: 9px 12px;
}

.link-button {
  background: transparent;
  color: #fca5a5;
  padding: 0;
  font-weight: 600;
}

.link-button.danger {
  color: #fca5a5;
}

.primary-button:hover,
.ghost-button:hover,
.link-button:hover {
  transform: translateY(-1px);
}

.list-actions {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
}

.entry-list {
  list-style: none;
  margin: 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.entry-item {
  background: rgba(15, 23, 42, 0.6);
  border: 1px solid rgba(148, 163, 184, 0.12);
  border-radius: 14px;
  padding: 14px 16px;
  display: flex;
  justify-content: space-between;
  gap: 12px;
}

.entry-item strong {
  display: block;
  margin-bottom: 4px;
}

.entry-item p {
  margin: 0;
  color: #cbd5e1;
}

.entry-meta {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8px;
}

.entry-meta span {
  font-size: 1rem;
  font-weight: 700;
}

.mini-actions {
  display: flex;
  gap: 12px;
}

.empty-state {
  padding: 12px 0 4px;
  margin: 0;
  color: #cbd5e1;
}

@media (max-width: 760px) {
  .summary-grid,
  .content-grid {
    grid-template-columns: 1fr;
  }

  .topbar,
  .section-header,
  .entry-item {
    flex-direction: column;
    align-items: flex-start;
  }

  .header-actions,
  .list-actions,
  .entry-meta {
    width: 100%;
    align-items: flex-start;
  }

  .mini-actions {
    gap: 16px;
  }
}
